
FROM nginx:alpine

WORKDIR /usr/share/nginx/html

COPY default.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /usr/share/nginx/html/lab3-7

COPY index.html /usr/share/nginx/html/lab3-7/index.html
COPY robots.txt /usr/share/nginx/html/lab3-7/robots.txt
COPY style.css /usr/share/nginx/html/lab3-7/style.css
